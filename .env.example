# Persisted artifacts are built offline by the ingestion/index commands.
LEXICAL_INDEX_DIR=artifacts/indices/lexical_sample
# Set both fields only after building a matching dense index and evaluating RRF.
DENSE_INDEX_DIR=
SEARCH_MODE=lexical
MAX_TOP_K=20
MAX_REQUEST_BYTES=16384
ALLOWED_ORIGINS=
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000
