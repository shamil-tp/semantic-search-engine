# Application Settings
APP_TITLE="Semantic Search Engine"
SEARCH_MODE=lexical # Options: lexical, dense, hybrid
HOST=127.0.0.1
PORT=8000
FLASK_DEBUG=0
LOG_LEVEL=INFO

# Artifact & Model Directories
LEXICAL_INDEX_DIR=artifacts/indices/lexical_sample
DENSE_INDEX_DIR=artifacts/indices/dense_sample

# Limits & Security
MAX_TOP_K=20
MAX_REQUEST_BYTES=16384
ALLOWED_ORIGINS="" # Optional comma-separated CORS origins
